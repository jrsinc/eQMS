# Copy to .env on the server (never commit .env). Values for production come from Azure Key Vault.
ORG_NAME=Your Company Name
HOST=127.0.0.1
PORT=8080
DATA_DIR=/opt/qms/data
# true when served over HTTPS (always in Validation and Production)
COOKIE_SECURE=true
SESSION_IDLE_MINUTES=15
# Initial password for the built-in "admin" account (forced change at first sign-in)
ADMIN_INITIAL_PASSWORD=
# Demo users for Development only. Never true in Validation or Production.
SEED_DEMO=false

# SharePoint publishing via Microsoft Graph (Entra app registration with Sites.Selected)
SP_TENANT_ID=
SP_CLIENT_ID=
SP_CLIENT_SECRET=
SP_SITE_ID=
SP_FOLDER=Effective Documents

# E-mail for notifications and passwords (Microsoft 365: smtp.office365.com, 587, STARTTLS; the mailbox needs "Authenticated SMTP" enabled)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=JRS eQMS
# Address people use to open the eQMS (used for links in e-mails), e.g. http://192.168.1.100:8080
APP_URL=
